+// In RetroArch shaders, "Texture" is the output of the previous pass (or the game frame for the
+// first pass), "InputSize"/"TextureSize" describe that input and "OutputSize" the pass target.
+void Video::setRetroArchUniforms(const ShaderChainEntry& shader, int pass, bool isLastPass, bool hasPreviousPass) {
+    static const GLfloat identity[16] = {
+        1.0F, 0.0F, 0.0F, 0.0F,
+        0.0F, 1.0F, 0.0F, 0.0F,
+        0.0F, 0.0F, 1.0F, 0.0F,
+        0.0F, 0.0F, 0.0F, 1.0F,
+    };
+
+    float inputWidth = getTextureWidth();
+    float inputHeight = getTextureHeight();
+    if (pass > 0) {
+        auto previous = renderer->getPassData(pass - 1);
+        inputWidth = (float) previous.width.value_or((unsigned) inputWidth);
+        inputHeight = (float) previous.height.value_or((unsigned) inputHeight);
+    }
+
+    float outputWidth;
+    float outputHeight;
+    if (isLastPass) {
+        auto& bounds = videoLayout.getRelativeForegroundBounds();
+        outputWidth = std::max(1.0F, (bounds[2] - bounds[0]) * videoLayout.getScreenWidth());
+        outputHeight = std::max(1.0F, (bounds[3] - bounds[1]) * videoLayout.getScreenHeight());
+    } else {
+        auto current = renderer->getPassData(pass);
+        outputWidth = (float) current.width.value_or(1);
+        outputHeight = (float) current.height.value_or(1);
+    }
+
+    if (shader.gMVPMatrixHandle != -1) glUniformMatrix4fv(shader.gMVPMatrixHandle, 1, GL_FALSE, identity);
+    if (shader.gFrameCountHandle != -1) glUniform1i(shader.gFrameCountHandle, (GLint) frameCount);
+    if (shader.gFrameDirectionHandle != -1) glUniform1i(shader.gFrameDirectionHandle, 1);
+    if (shader.gOutputSizeHandle != -1) glUniform2f(shader.gOutputSizeHandle, outputWidth, outputHeight);
+    if (shader.gInputSizeHandle != -1) glUniform2f(shader.gInputSizeHandle, inputWidth, inputHeight);
+    if (shader.gRetroTextureSizeHandle != -1) glUniform2f(shader.gRetroTextureSizeHandle, inputWidth, inputHeight);
+    if (shader.gOrigInputSizeHandle != -1) glUniform2f(shader.gOrigInputSizeHandle, getTextureWidth(), getTextureHeight());
+    if (shader.gOrigTextureHandle != -1) glUniform1i(shader.gOrigTextureHandle, 0);
+    if (shader.gRetroTextureHandle != -1) glUniform1i(shader.gRetroTextureHandle, hasPreviousPass ? 1 : 0);
 }
 
