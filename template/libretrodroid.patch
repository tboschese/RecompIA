+// Custom chains are described entirely by params:
+//   passes=N, linear_texture=0|1 and, for each pass i,
+//   pass<i>_vertex, pass<i>_fragment, pass<i>_linear=0|1, pass<i>_scale=<float>
+ShaderManager::Chain ShaderManager::buildCustomChain(
+    const std::unordered_map<std::string, std::string>& params
+) {
+    auto get = [&params](const std::string& key, const std::string& fallback) {
+        auto it = params.find(key);
+        return it != params.end() ? it->second : fallback;
+    };
+
+    Chain chain;
+    chain.linearTexture = get("linear_texture", "0") == "1";
+
+    int count = std::stoi(get("passes", "0"));
+    for (int i = 0; i < count; ++i) {
+        std::string prefix = "pass" + std::to_string(i) + "_";
+        std::string vertex = get(prefix + "vertex", "");
+        std::string fragment = get(prefix + "fragment", "");
+        if (vertex.empty() || fragment.empty()) {
+            return {};
+        }
+        chain.passes.push_back({
+            vertex,
+            fragment,
+            get(prefix + "linear", "0") == "1",
+            std::stof(get(prefix + "scale", "1.0"))
+        });
+    }
+    return chain;
+}
