@@ -1602,9 +1602,49 @@ ShaderManager::Chain ShaderManager::getShader(const ShaderManager::Config& confi
             false
         };
     }
+
+    case Type::SHADER_CUSTOM: {
+        Chain chain = buildCustomChain(config.params);
+        if (chain.passes.empty()) {
+            return getShader({ Type::SHADER_DEFAULT, {} });
+        }
+        return chain;
+    }
 }
